# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real credentials.

# Anthropic (Claude) API — used in Generate_script.py
ANTHROPIC_API_KEY=

# Gemini API — fallback used in Generate_script.py
GEMINI_API_KEY=

# ElevenLabs API — used in Generate_audio.py
ELEVENLABS_API_KEY=
# Optional: specific voice_id (defaults to a generic multilingual voice).
# To find a good one for Portuguese, run client.voices.search(language="pt")
ELEVENLABS_VOICE_ID=
